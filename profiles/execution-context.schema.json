{
  "$defs": {
    "Digest": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256",
          "default": "sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "value": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Digest",
      "type": "object"
    },
    "ExecutionRuntime": {
      "additionalProperties": false,
      "description": "Portable resolver and platform facts for one execution context.",
      "properties": {
        "dependency_lock": {
          "$ref": "#/$defs/RecordReference"
        },
        "interpreter": {
          "minLength": 1,
          "title": "Interpreter",
          "type": "string"
        },
        "platform": {
          "minLength": 1,
          "title": "Platform",
          "type": "string"
        }
      },
      "required": [
        "interpreter",
        "platform",
        "dependency_lock"
      ],
      "title": "ExecutionRuntime",
      "type": "object"
    },
    "JsonValue": {},
    "RecordReference": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "RecordReference",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Canonical profile payload describing an Invocation's execution context.",
  "properties": {
    "annotations": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Annotations",
      "type": "object"
    },
    "configuration": {
      "anyOf": [
        {
          "$ref": "#/$defs/RecordReference"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "oclp_profile": {
      "const": "execution-context",
      "default": "execution-context",
      "title": "Oclp Profile",
      "type": "string"
    },
    "oclp_profile_version": {
      "const": "0.1.0-draft",
      "default": "0.1.0-draft",
      "title": "Oclp Profile Version",
      "type": "string"
    },
    "runtime": {
      "$ref": "#/$defs/ExecutionRuntime"
    }
  },
  "required": [
    "runtime"
  ],
  "title": "ExecutionContextManifest",
  "type": "object"
}
