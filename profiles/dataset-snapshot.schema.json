{
  "$defs": {
    "DatasetSnapshotPartition": {
      "additionalProperties": false,
      "description": "One named partition bound to an exact Artifact record.",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/RecordReference"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "values": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Values",
          "type": "object"
        }
      },
      "required": [
        "name",
        "artifact"
      ],
      "title": "DatasetSnapshotPartition",
      "type": "object"
    },
    "Digest": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256",
          "default": "sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "value": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Digest",
      "type": "object"
    },
    "JsonValue": {},
    "RecordReference": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "RecordReference",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Canonical metadata for one immutable logical dataset version.",
  "properties": {
    "annotations": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Annotations",
      "type": "object"
    },
    "data_format": {
      "minLength": 1,
      "title": "Data Format",
      "type": "string"
    },
    "dataset_id": {
      "minLength": 1,
      "title": "Dataset Id",
      "type": "string"
    },
    "oclp_profile": {
      "const": "dataset-snapshot",
      "default": "dataset-snapshot",
      "title": "Oclp Profile",
      "type": "string"
    },
    "oclp_profile_version": {
      "const": "0.1.0-draft",
      "default": "0.1.0-draft",
      "title": "Oclp Profile Version",
      "type": "string"
    },
    "parent": {
      "anyOf": [
        {
          "$ref": "#/$defs/RecordReference"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "partitions": {
      "items": {
        "$ref": "#/$defs/DatasetSnapshotPartition"
      },
      "minItems": 1,
      "title": "Partitions",
      "type": "array"
    }
  },
  "required": [
    "dataset_id",
    "data_format",
    "partitions"
  ],
  "title": "DatasetSnapshotManifest",
  "type": "object"
}
