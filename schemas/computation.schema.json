{
  "$defs": {
    "ArtifactSource": {
      "additionalProperties": false,
      "description": "An immutable Artifact selected as an implementation's source basis.",
      "properties": {
        "kind": {
          "const": "artifact",
          "default": "artifact",
          "title": "Kind",
          "type": "string"
        },
        "artifact": {
          "$ref": "#/$defs/RecordReference"
        }
      },
      "required": [
        "artifact"
      ],
      "title": "ArtifactSource",
      "type": "object"
    },
    "Digest": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256",
          "default": "sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "value": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Digest",
      "type": "object"
    },
    "GitSource": {
      "additionalProperties": false,
      "description": "A Git source basis selected by an implementation.",
      "properties": {
        "kind": {
          "const": "git",
          "default": "git",
          "title": "Kind",
          "type": "string"
        },
        "repository": {
          "minLength": 1,
          "title": "Repository",
          "type": "string"
        },
        "commit": {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "title": "Commit",
          "type": "string"
        },
        "path": {
          "default": ".",
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "dirty": {
          "default": false,
          "title": "Dirty",
          "type": "boolean"
        },
        "overlay": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "repository",
        "commit"
      ],
      "title": "GitSource",
      "type": "object"
    },
    "Implementation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "python-callable",
            "container",
            "command",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "discriminator": {
            "mapping": {
              "artifact": "#/$defs/ArtifactSource",
              "git": "#/$defs/GitSource",
              "opaque": "#/$defs/OpaqueSource",
              "service": "#/$defs/ServiceSource"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/GitSource"
            },
            {
              "$ref": "#/$defs/ArtifactSource"
            },
            {
              "$ref": "#/$defs/ServiceSource"
            },
            {
              "$ref": "#/$defs/OpaqueSource"
            }
          ],
          "title": "Source"
        }
      },
      "required": [
        "kind",
        "locator",
        "source"
      ],
      "title": "Implementation",
      "type": "object"
    },
    "JsonValue": {},
    "OpaqueSource": {
      "additionalProperties": false,
      "description": "An explicitly unavailable implementation source basis.",
      "properties": {
        "kind": {
          "const": "opaque",
          "default": "opaque",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "reason"
      ],
      "title": "OpaqueSource",
      "type": "object"
    },
    "PortDefinition": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "cardinality": {
          "default": "one",
          "enum": [
            "one",
            "many"
          ],
          "title": "Cardinality",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "media_types": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Media Types",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "PortDefinition",
      "type": "object"
    },
    "ParameterDefinition": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schema": {
          "additionalProperties": true,
          "title": "Schema",
          "type": "object"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "schema"
      ],
      "title": "ParameterDefinition",
      "type": "object"
    },
    "RecordReference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id"
      ],
      "title": "RecordReference",
      "type": "object"
    },
    "ServiceSource": {
      "additionalProperties": false,
      "description": "A versioned external service selected as an implementation's source basis.",
      "properties": {
        "kind": {
          "const": "service",
          "default": "service",
          "title": "Kind",
          "type": "string"
        },
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "locator",
        "version"
      ],
      "title": "ServiceSource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A reusable, source-bound computation interface and implementation.",
  "properties": {
    "oclp_version": {
      "const": "0.2.0-draft",
      "default": "0.2.0-draft",
      "title": "Oclp Version",
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "name": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "profiles": {
      "anyOf": [
        {
          "additionalProperties": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          "minProperties": 1,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Profiles"
    },
    "annotations": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Annotations",
      "type": "object"
    },
    "kind": {
      "const": "computation",
      "default": "computation",
      "title": "Kind",
      "type": "string"
    },
    "implementation": {
      "$ref": "#/$defs/Implementation"
    },
    "input_ports": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PortDefinition"
      },
      "title": "Input Ports",
      "type": "array"
    },
    "output_ports": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PortDefinition"
      },
      "title": "Output Ports",
      "type": "array"
    },
    "parameter_definitions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ParameterDefinition"
      },
      "title": "Parameter Definitions",
      "type": "array"
    },
    "required_evidence": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/Implementation"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Required Evidence"
    }
  },
  "required": [
    "id",
    "implementation"
  ],
  "title": "Computation",
  "type": "object"
}
