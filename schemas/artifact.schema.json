{
  "$defs": {
    "Digest": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256",
          "default": "sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "value": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Digest",
      "type": "object"
    },
    "JsonValue": {}
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "annotations": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Annotations",
      "type": "object"
    },
    "digest": {
      "$ref": "#/$defs/Digest"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "const": "artifact",
      "default": "artifact",
      "title": "Kind",
      "type": "string"
    },
    "locations": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Locations",
      "type": "array"
    },
    "media_type": {
      "minLength": 1,
      "title": "Media Type",
      "type": "string"
    },
    "oclp_version": {
      "const": "0.1.0-draft",
      "default": "0.1.0-draft",
      "title": "Oclp Version",
      "type": "string"
    },
    "schema_uri": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Schema Uri"
    },
    "size": {
      "minimum": 0,
      "title": "Size",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "media_type",
    "digest",
    "size"
  ],
  "title": "Artifact",
  "type": "object"
}
