{
  "$defs": {
    "Digest": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256",
          "default": "sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "value": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Digest",
      "type": "object"
    },
    "JsonValue": {},
    "RecordReference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "id"
      ],
      "title": "RecordReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One concrete run of a Computation with immutable I/O bindings.",
  "properties": {
    "annotations": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Annotations",
      "type": "object"
    },
    "computation": {
      "$ref": "#/$defs/RecordReference"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "inputs": {
      "additionalProperties": {
        "items": {
          "$ref": "#/$defs/RecordReference"
        },
        "type": "array"
      },
      "title": "Inputs",
      "type": "object"
    },
    "kind": {
      "const": "execution",
      "default": "execution",
      "title": "Kind",
      "type": "string"
    },
    "name": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "description": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "oclp_version": {
      "const": "0.3.0-draft",
      "default": "0.3.0-draft",
      "title": "Oclp Version",
      "type": "string"
    },
    "outputs": {
      "anyOf": [
        {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/RecordReference"
            },
            "type": "array"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Outputs"
    },
    "parameters": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Parameters",
      "type": "object"
    },
    "parent_execution": {
      "anyOf": [
        {
          "$ref": "#/$defs/RecordReference"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "profiles": {
      "anyOf": [
        {
          "additionalProperties": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          "minProperties": 1,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Profiles"
    },
    "requested_outputs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Requested Outputs",
      "type": "array"
    }
  },
  "required": [
    "id",
    "computation"
  ],
  "title": "Execution",
  "type": "object"
}
