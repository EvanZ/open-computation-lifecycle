    "ExecutionContext": {
      "additionalProperties": false,
      "description": "Execution-local runtime context attached to a lifecycle observation.",
      "properties": {
        "git_checkout": {
          "anyOf": [
            {
              "$ref": "#/$defs/GitCheckout"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "ExecutionContext",
      "type": "object"
    },
    "GitCheckout": {
      "additionalProperties": false,
      "description": "The local Git worktree observed for one Execution.",
      "properties": {
        "kind": {
          "const": "git",
          "default": "git",
          "title": "Kind",
          "type": "string"
        },
        "worktree": {
          "minLength": 1,
          "title": "Worktree",
          "type": "string"
        },
        "commit": {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "title": "Commit",
          "type": "string"
        },
        "dirty": {
          "default": false,
          "title": "Dirty",
          "type": "boolean"
        }
      },
      "required": [
        "worktree",
        "commit"
      ],
      "title": "GitCheckout",
      "type": "object"
    },
    "GitSource": {
      "additionalProperties": false,
      "description": "An immutable Git source revision selected by an implementation.",
      "properties": {
        "kind": {
          "const": "git",
          "default": "git",
          "title": "Kind",
          "type": "string"
