    "Implementation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "python-callable",
            "container",
            "command",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "discriminator": {
            "mapping": {
              "artifact": "#/$defs/ArtifactSource",
              "git": "#/$defs/GitSource",
              "opaque": "#/$defs/OpaqueSource",
              "service": "#/$defs/ServiceSource"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/GitSource"
            },
            {
              "$ref": "#/$defs/ArtifactSource"
            },
            {
              "$ref": "#/$defs/ServiceSource"
            },
            {
              "$ref": "#/$defs/OpaqueSource"
            }
          ],
          "title": "Source"
        }
      },
      "required": [
        "kind",
        "locator",
        "source"
      ],
      "title": "Implementation",
      "type": "object"
    },
