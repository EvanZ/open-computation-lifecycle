      },
      "required": [
        "name",
        "artifact"
      ],
      "title": "ArtifactSetMember",
      "type": "object"
    },
    "ArtifactSource": {
      "additionalProperties": false,
      "description": "An immutable Artifact selected as an implementation's source basis.",
