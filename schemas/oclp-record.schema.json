        "created_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Created At"
        }
      },
      "required": [
        "id",
        "members"
      ],
      "title": "ArtifactSet",
      "type": "object"
    },
    "ArtifactSetMember": {
      "additionalProperties": false,
      "description": "One immutable Artifact assigned a stable name and semantic role.",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "artifact": {
          "$ref": "#/$defs/RecordReference"
