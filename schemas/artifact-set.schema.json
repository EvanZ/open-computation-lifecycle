{
  "$defs": {
    "ArtifactSetMember": {
      "additionalProperties": false,
      "description": "One immutable Artifact assigned a stable name and semantic role.",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/RecordReference"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "role": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        }
      },
      "required": [
        "name",
        "artifact"
      ],
      "title": "ArtifactSetMember",
      "type": "object"
    },
    "Digest": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "sha256",
          "default": "sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "value": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Digest",
      "type": "object"
    },
    "JsonValue": {},
    "RecordReference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "id"
      ],
      "title": "RecordReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "An immutable, named collection of exact Artifact references.",
  "properties": {
    "annotations": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Annotations",
      "type": "object"
    },
    "created_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created At"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "kind": {
      "const": "artifact_set",
      "default": "artifact_set",
      "title": "Kind",
      "type": "string"
    },
    "members": {
      "items": {
        "$ref": "#/$defs/ArtifactSetMember"
      },
      "minItems": 1,
      "title": "Members",
      "type": "array"
    },
    "name": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "description": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "oclp_version": {
      "const": "0.3.0-draft",
      "default": "0.3.0-draft",
      "title": "Oclp Version",
      "type": "string"
    },
    "profiles": {
      "anyOf": [
        {
          "additionalProperties": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          "minProperties": 1,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Profiles"
    }
  },
  "required": [
    "id",
    "members"
  ],
  "title": "ArtifactSet",
  "type": "object"
}
